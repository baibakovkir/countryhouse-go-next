POSTGRES_DB=countryhouse
POSTGRES_USER=countryhouse
POSTGRES_PASSWORD=countryhouse_dev
DATABASE_URL=postgres://countryhouse:countryhouse_dev@postgres:5432/countryhouse?sslmode=disable
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8080

# Required once when upgrading a database that already contains plots.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
