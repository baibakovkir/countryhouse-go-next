{$CADDY_SITE_ADDRESS} {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /healthz {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
