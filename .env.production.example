GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/countryhouse

POSTGRES_DB=countryhouse
POSTGRES_USER=countryhouse
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
DATABASE_URL=postgres://countryhouse:replace-with-a-long-random-alphanumeric-secret@postgres:5432/countryhouse?sslmode=disable

CORS_ALLOWED_ORIGIN=https://app.example.com
COOKIE_SECURE=true

# Required when the upgraded database contains plots created before authentication.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
